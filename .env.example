# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CREDENTIALS (for persistent PostgreSQL & Auth production deployment):
# Configure these in production or use the built-in local reactive repository engine in sandbox mode.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# MULTICAIXA EXPRESS PAYMENT GATEWAY INTEGRATION:
# Adapter configuration for Angolan Authorized Payment Service Provider (e.g. EMIS / Proxypay / AppyPay)
MULTICAIXA_GATEWAY_PROVIDER="EMIS_ADAPTER_SANDBOX"
MULTICAIXA_API_KEY=""
MULTICAIXA_API_SECRET=""
MULTICAIXA_WEBHOOK_SECRET=""
